{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "WikiPulse chart values",
  "description": "Helm checks the merged values against this schema before rendering (install, upgrade, template, lint). A typo or a forbidden value fails early, with a message, instead of producing a broken cluster.",
  "type": "object",
  "required": ["image", "existingSecret", "config", "externalServices", "modelCache", "migrations", "networkPolicies",
               "consumer", "detector", "archiver", "enricher", "grouper", "graph", "api"],
  "definitions": {
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"type": "object", "required": ["cpu", "memory"]},
        "limits": {"type": "object", "required": ["cpu", "memory"]}
      }
    },
    "ports": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1, "maximum": 65535},
      "uniqueItems": true
    },
    "command": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "worker": {
      "description": "A singleton worker: never more than one replica (see values.yaml).",
      "type": "object",
      "required": ["replicas", "command", "terminationGracePeriodSeconds", "resources", "heartbeat", "startup", "egressPorts"],
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 0, "maximum": 1},
        "command": {"$ref": "#/definitions/command"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
        "resources": {"$ref": "#/definitions/resources"},
        "heartbeat": {
          "type": "object",
          "required": ["readyMaxAge", "liveMaxAge"],
          "additionalProperties": false,
          "properties": {
            "readyMaxAge": {"type": "integer", "minimum": 1},
            "liveMaxAge": {"type": "integer", "minimum": 1}
          }
        },
        "startup": {
          "type": "object",
          "required": ["periodSeconds", "failureThreshold"],
          "additionalProperties": false,
          "properties": {
            "periodSeconds": {"type": "integer", "minimum": 1},
            "failureThreshold": {"type": "integer", "minimum": 1}
          }
        },
        "egressPorts": {"$ref": "#/definitions/ports"},
        "modelCache": {"type": "boolean"}
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "existingSecret": {"type": "string", "minLength": 1},
    "checksums": {
      "description": "Set by Terraform (infra/cluster); empty otherwise.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chart": {"type": "string"},
        "secret": {"type": "string"}
      }
    },
    "config": {
      "description": "Environment variables for every container. Nothing secret: passwords, DSNs, keys and the User-Agent belong in the Secret.",
      "type": "object",
      "additionalProperties": {"type": ["string", "number", "boolean"]},
      "propertyNames": {"not": {"pattern": "PASSWORD|SECRET|DSN|KEY|USER_AGENT"}}
    },
    "externalServices": {
      "type": "object",
      "required": ["host", "names"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "names": {"type": "array", "items": {"type": "string"}}
      }
    },
    "modelCache": {
      "type": "object",
      "required": ["size"],
      "properties": {"size": {"type": "string"}, "storageClass": {"type": "string"}}
    },
    "migrations": {
      "type": "object",
      "required": ["enabled", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "databaseHost": {"type": "string"},
        "resources": {"$ref": "#/definitions/resources"}
      }
    },
    "networkPolicies": {
      "type": "object",
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "consumer": {"$ref": "#/definitions/worker"},
    "detector": {"$ref": "#/definitions/worker"},
    "archiver": {"$ref": "#/definitions/worker"},
    "enricher": {"$ref": "#/definitions/worker"},
    "grouper": {"$ref": "#/definitions/worker"},
    "graph": {"$ref": "#/definitions/worker"},
    "api": {
      "description": "Stateless: any number of replicas.",
      "type": "object",
      "required": ["replicas", "command", "terminationGracePeriodSeconds", "port", "resources", "egressPorts"],
      "additionalProperties": false,
      "properties": {
        "replicas": {"type": "integer", "minimum": 0},
        "command": {"$ref": "#/definitions/command"},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "resources": {"$ref": "#/definitions/resources"},
        "egressPorts": {"$ref": "#/definitions/ports"},
        "modelCache": {"type": "boolean"},
        "podDisruptionBudget": {
          "type": "object",
          "properties": {"enabled": {"type": "boolean"}, "minAvailable": {"type": "integer", "minimum": 0}}
        }
      }
    }
  }
}
