# Copy this file to .env and fill in your own values. Never commit .env.

# --- Wikimedia User-Agent (required) ---
# Wikimedia's policy requires a descriptive User-Agent with a way to contact you:
# https://meta.wikimedia.org/wiki/User-Agent_policy
# Replace the GitHub owner and the email with your own. While it still contains the
# placeholder you@example.com, `uv run python -m wikipulse.check` prints a warning.
USER_AGENT="WikiPulse/0.1 (https://github.com/IoakeimKyrgiafinis/wikipulse; you@example.com)"

# --- Logging ---
LOG_LEVEL=INFO
# text (readable, the default) or json (one JSON object per line, for Loki; the cluster).
LOG_FORMAT=text
# The `service` field of every log line (unset: the module that was started).
# LOG_SERVICE=
# One log line per edit written to the stream, with its correlation id (the cluster: true).
LOG_EDITS=false

# --- Local data directory (recordings, caches; never committed) ---
DATA_DIR=data

# --- Health (Kubernetes, stage 8) ---
# Workers touch this file as they work; `python -m wikipulse.health` (the probe) checks it
# is fresh. Leave unset outside a container. The cluster sets it in k8s/configmap.yaml.
# HEALTH_FILE=/tmp/heartbeat

# --- Metrics (Prometheus, stage 9) ---
# A port turns on /metrics in the process you start (one port per process). The cluster
# sets METRICS_PORT=9400 and METRICS_HOST=0.0.0.0 in every pod. On the laptop, e.g.
#   METRICS_PORT=9464 uv run python -m wikipulse.stream.replay --file ... --speed 2
# METRICS_PORT=
# METRICS_HOST=127.0.0.1
# Seconds the API waits for Postgres when Prometheus scrapes the model health metrics.
# METRICS_DB_CONNECT_TIMEOUT_S=5

# --- Live stream consumer (stage 1) ---
# Wikimedia EventStreams URL (Server-Sent Events).
STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
# Redis Stream that receives filtered, normalized English Wikipedia article edits.
STREAM_KEY=wiki:edits
# Redis Stream that replay writes to by default (separate, so replays never touch STREAM_KEY).
REPLAY_STREAM_KEY=wiki:replay:edits
# Approximate maximum length of that Redis Stream (older entries are trimmed).
STREAM_MAXLEN=1000000
# Longest wait between reconnect attempts, in seconds (exponential backoff with jitter).
RECONNECT_MAX_S=60
# Only one live consumer writes STREAM_KEY at a time: it holds the Redis key
# <STREAM_KEY>:writer, renewed while it runs. A second consumer waits until the lease is
# released (clean stop) or expires (a killed consumer) after this many seconds.
STREAM_LEASE_TTL_S=30

# --- Spike detection (stage 2) ---
# Sliding windows, in minutes: the short one is the "now" signal; edits enter a page's
# baseline only after they leave the long one.
DETECT_SHORT_WINDOW_MIN=10
DETECT_LONG_WINDOW_MIN=60
# Start rule, short window: at least this many human edits from this many people...
DETECT_MIN_EDITS=5
DETECT_MIN_EDITORS=3
# ...or, long window: at least this many edits from this many people.
DETECT_LONG_MIN_EDITS=10
DETECT_LONG_MIN_EDITORS=4
# Either way, also at least this many times the page's expected (baseline) count.
DETECT_MIN_RATIO=5.0
# Lowest expected edits per short window used in the score (z-score stays finite).
DETECT_EXPECTED_FLOOR=0.5
# A spike stays "hot" while its short window holds this many edits, and ends after
# this many minutes without being hot.
DETECT_CONTINUE_MIN_EDITS=2
DETECT_QUIET_PERIOD_MIN=30
# Baseline time constant (hours) and when to forget a page (edits per day).
DETECT_BASELINE_TAU_HOURS=24
DETECT_BASELINE_PRUNE_PER_DAY=0.05
# Daily rhythm: overall edit rate over this many hours vs. over the baseline period,
# clamped to [min, max].
DETECT_RHYTHM_TAU_HOURS=1
DETECT_RHYTHM_MIN=0.5
DETECT_RHYTHM_MAX=2.0
# Count reverts ("Reverted ...", "Undid ...") toward detection? (true/false)
DETECT_COUNT_REVERTS=false
# Seconds between state snapshots to Redis (and spike writes to Postgres). Keep it
# well under a minute so new spikes are enriched within a minute (stage 3).
DETECT_SNAPSHOT_INTERVAL_S=30

# --- Detection evaluation (stage 2) ---
# English Wikipedia's MediaWiki Action API and REST API (portal pages, page summaries).
WIKI_API_URL=https://en.wikipedia.org/w/api.php
WIKI_REST_URL=https://en.wikipedia.org/api/rest_v1
# Smallest pause between two requests to Wikimedia APIs, in seconds. Responses are cached.
WIKI_API_MIN_INTERVAL_S=1.0
# Model that labels spikes for label-based precision, as backend:model.
EVAL_LABEL_MODEL=ollama:qwen3:8b

# --- Page enrichment (stage 3) ---
# Most Wikimedia API requests in flight at once.
WIKI_API_CONCURRENCY=4
# Smallest pause between the starts of two enrichment requests, in seconds.
ENRICH_MIN_INTERVAL_S=0.5
# Hours a cached API response (and an enriched page) stays fresh.
ENRICH_CACHE_TTL_H=24
# Most outgoing article links kept per page.
ENRICH_MAX_LINKS=5000
# Seconds between two looks for new spikes.
ENRICH_POLL_INTERVAL_S=10

# --- Event grouping (stage 3) ---
# Weights of the three signals in the pairwise score: one page links to the other, the
# spikes started close in time, the summaries mean similar things (embeddings).
EVENTS_LINK_WEIGHT=0.4
EVENTS_TIME_WEIGHT=0.2
EVENTS_EMBED_WEIGHT=0.4
# Time signal falls from 1 (same moment) to 0 at this many hours between spike starts.
EVENTS_TIME_WINDOW_H=6
# Embedding signal: cosine similarity at or below this counts 0 (unrelated summaries).
EVENTS_EMBED_FLOOR=0.5
# A spike joins an active event when its score with one of its pages reaches this.
EVENTS_JOIN_THRESHOLD=0.55
# Links from pages with more links than this count proportionally less (0: off).
EVENTS_LINK_HUB_SIZE=1000
# A link counts only if the summaries reach this cosine similarity, so a link from a list
# page to an unrelated article ("Deaths in 2026") can't join pages on its own (0: off).
EVENTS_LINK_MIN_COSINE=0.5
# A spike counts as over this many minutes after its last edit (detector quiet period).
EVENTS_SPIKE_CLOSE_MIN=30
# Embedding model for page summaries (sentence-transformers, runs locally on the CPU).
EVENTS_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Seconds between two looks for new spikes.
EVENTS_POLL_INTERVAL_S=10
# Seconds a live spike waits for its page to be enriched before it is grouped anyway.
EVENTS_ENRICH_WAIT_S=120

# --- LLM client (stage 4) ---
# Model used when no other is named, as backend:model. Backends: ollama (local, free),
# anthropic (optional, needs `uv sync --extra anthropic` and ANTHROPIC_API_KEY).
DEFAULT_MODEL=ollama:qwen3:4b
# Local Ollama server.
OLLAMA_HOST=http://localhost:11434
# Context window in tokens, sent with every call (Ollama silently truncates beyond it).
OLLAMA_NUM_CTX=8192
# How long Ollama keeps a model loaded after a call ("10m", "1h", "0" to unload at once).
OLLAMA_KEEP_ALIVE=10m
# Longest wait for one LLM answer, in seconds.
LLM_TIMEOUT_S=120
# Only for the optional anthropic backend. Leave unset otherwise.
# ANTHROPIC_API_KEY=
# LLM and agent tracing with Langfuse (spec 09b): set both keys to send traces, leave
# them unset to trace nothing (a silent no-op). LANGFUSE_HOST: the cloud region or a
# self-hosted server.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Knowledge graph (stage 4) ---
# Neo4j connection (Neo4j Browser: http://localhost:7474, user neo4j, NEO4J_PASSWORD).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# At least 8 characters. Used by Docker Compose for the container and by the Python code.
# Changing it after the first start needs the neo4j-data volume to be recreated.
NEO4J_PASSWORD=wikipulse-graph
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Model that extracts entities and relationships from events, as backend:model.
EXTRACT_MODEL=ollama:qwen3:4b
# Wikidata API, for linking entity names to Wikidata IDs.
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# Pages per event shown to the extraction model (highest spike score first), and the
# characters kept of each page's summary and of its recent changes.
EXTRACT_MAX_PAGES=6
EXTRACT_MAX_CHARS=1200
# Seconds between two looks for new or changed events.
GRAPH_POLL_INTERVAL_S=30
# Wikidata Query Service (SPARQL), the ground truth of the extraction evaluation.
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql

# --- Question answering over the graph (stage 5) ---
# Model that writes Cypher queries and answers questions, as backend:model.
QA_MODEL=ollama:qwen3:8b
# A generated Cypher query returns at most this many rows and runs at most this long.
QA_CYPHER_MAX_ROWS=25
QA_CYPHER_TIMEOUT_S=5
# Vector search over page summaries and events: results per question, and the lowest
# cosine similarity between question and text that still counts as relevant.
QA_VECTOR_TOP_K=5
QA_VECTOR_MIN_COSINE=0.63
# Most facts handed to the answering model.
QA_MAX_FACTS=60

# --- Question-answering evaluation (stage 5) ---
# The frozen graph snapshot that evaluations ask: a second Neo4j server (docker compose
# service neo4j-eval, profile "eval"), filled by `scripts/snapshot_graph.py restore`.
NEO4J_EVAL_HTTP_PORT=7475
NEO4J_EVAL_BOLT_PORT=7688
EVAL_QA_NEO4J_URI=bolt://localhost:7688
# Judge models (comma-separated backend:model). The first scores the answers; the others
# judge the same answers so the report can show how far judges agree.
EVAL_QA_JUDGES=ollama:qwen3:8b,ollama:qwen3:4b

# --- MCP server (stage 5): uv run python -m wikipulse.mcp_server.server ---
# Address of the HTTP transport (--transport http). Loopback only: the server has no
# authentication, so it refuses any other host.
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8765
# Trending events = active events plus those that started this many hours before the
# graph's newest event (event time).
MCP_TRENDING_HOURS=24

# --- Analyst agent (stage 5): uv run python -m wikipulse.agent.run ---
# Model that investigates events and writes the briefings, as backend:model.
AGENT_MODEL=ollama:qwen3:8b
# Let the model think before each answer (slower).
AGENT_THINK=false
# Check each sentence of a briefing against the data it cites; drop unsupported ones.
AGENT_VERIFY=true
# Limits of one run: model turns with tools, tokens (in + out, all calls), seconds.
AGENT_MAX_STEPS=8
AGENT_TOKEN_BUDGET=60000
AGENT_RUN_TIMEOUT_S=900
# Per-tool timeouts in seconds (ask runs an LLM, so it gets longer).
AGENT_TOOL_TIMEOUT_S=30
AGENT_ASK_TIMEOUT_S=180
# A tool result shown to the model is cut at this many characters.
AGENT_MAX_RESULT_CHARS=5000
# Trigger: brief events whose best spike score reaches this, or with this many pages.
AGENT_MIN_SPIKE_SCORE=9.0
AGENT_MIN_PAGES=3
# Seconds between two looks for new significant events.
AGENT_POLL_INTERVAL_S=60

# --- Stage 5: web API and live page (wikipulse.api) ---
# Address of the API and the page (loopback only: there is no authentication).
API_HOST=127.0.0.1
# Only in a container: allow API_HOST=0.0.0.0 (a network policy then decides who connects;
# requests must still name a loopback host). k8s/api.yaml sets both.
API_LISTEN_ALL=false
API_PORT=8000
# The grouping run whose events the page shows (`live` for the live pipeline).
API_RUN_ID=live
# Seconds between two looks for new and changed events (pushed over the WebSocket).
API_POLL_INTERVAL_S=5
# How many of the most recent events the WebSocket watches and sends on connect.
API_WATCH_LIMIT=200
# Questions run one at a time; with more than this many waiting, /ask answers 429.
API_MAX_WAITING_QUESTIONS=3

# --- Data lake (stage 6): uv run python -m wikipulse.lake.archive ---
# S3-compatible object storage. Locally the `rustfs` service of docker-compose.yml; on AWS
# use https://s3.<region>.amazonaws.com and real credentials (never commit them).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=wikipulse-lake
S3_REGION=us-east-1
# Local development defaults only. Docker Compose uses them as the server's root login
# (web console: http://localhost:9001); changing them later needs the rustfs-data volume
# to be recreated.
S3_ACCESS_KEY=wikipulse
S3_SECRET_KEY=wikipulse-lake
S3_PORT=9000
S3_CONSOLE_PORT=9001
# Key prefix of the edit archive inside the bucket (edits/year=.../hour=.../part-0.parquet).
LAKE_PREFIX=edits
# Consumer group the archiver reads STREAM_KEY with (independent of the detector's).
LAKE_GROUP=lake:archive
# Seconds between writes of buffered edits (each write acknowledges them), and how many
# buffered edits force a write earlier.
LAKE_FLUSH_INTERVAL_S=300
LAKE_MAX_BUFFER_ROWS=50000
# Seconds until the single-writer lock of a killed archiver expires (a restart waits at
# most this long; a second archiver started by mistake waits instead of writing).
LAKE_LOCK_TTL_S=60

# --- Event-driven worker (stage 6): uv run python -m wikipulse.workers.run ---
# Set up once with `uv run python -m wikipulse.workers.setup`: the object store then
# publishes an "object created" event on this Redis pub/sub channel for every new
# Parquet file in S3_BUCKET.
LAKE_NOTIFY_CHANNEL=lake:notifications
# Redis as the object store reaches it (inside Docker: the Compose service name).
LAKE_NOTIFY_REDIS_URL=redis://redis:6379/0
# Name of the notification target inside the object store.
LAKE_NOTIFY_TARGET=wikipulse
# A failing handler is tried this many times in all (waiting 2 s, 4 s, ... in between),
# then the notification goes to the dead-letter list (a Redis list) for inspection.
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_DELAY_S=2
WORKER_DEAD_LETTER_KEY=workers:hourly_stats:dead
# Most edited pages kept per hour in hourly_stats.top_pages.
WORKER_TOP_PAGES=10

# --- Scheduled jobs (stage 6): Airflow runs wikipulse.jobs daily (dags/) ---
# Detector run the daily detection evaluation scores (`live`: the live detector).
JOBS_EVAL_RUN_ID=live
# Data quality of a day in daily_stats: an hour with fewer edits than this share of the
# day's median hour, or a day with fewer edits than this share of the mean of up to
# JOBS_BASELINE_DAYS earlier complete days, is a "sudden volume drop" (the check fails).
JOBS_HOUR_DROP_RATIO=0.3
JOBS_DAY_DROP_RATIO=0.5
JOBS_BASELINE_DAYS=7
# Airflow (docker compose --profile airflow up -d): web UI on http://localhost:8080,
# metadata in this database of the Postgres service (created on first start).
AIRFLOW_PORT=8080
AIRFLOW_DB=airflow
# Local development only: signs the tokens Airflow's components exchange. Any long
# random string; never reuse a real secret here.
AIRFLOW_JWT_SECRET=wikipulse-local-dev-only-change-me

# --- Training data (stage 7): uv run python -m wikipulse.ml.dataset build ---
# Features of a spike use only what is known this many minutes after it started.
FEATURE_WINDOW_MIN=10
# Lake prefix (in S3_BUCKET) the dataset reads edits from, and where datasets are written
# (<S3_BUCKET>/<ML_DATASET_PREFIX>/v<n>/).
ML_LAKE_PREFIX=history/edits
ML_DATASET_PREFIX=datasets
# Candidate spikes: the detector with these changes to the DETECT_* thresholds (looser
# than the live defaults, so the classifier sees more borderline spikes).
ML_CANDIDATE_DETECTOR=min_edits=4,min_editors=3,long_min_edits=8,long_min_editors=3
# Hours at the start of the lake used only to warm up baselines (no spikes taken), and
# the last days of data held out for validation and testing (time-based split).
ML_WARMUP_HOURS=24
ML_VALID_DAYS=1
ML_TEST_DAYS=2
# Purge at split boundaries: a spike is left out of its split when the same page spikes
# again in a later split less than this many hours after it ended (spikes still running
# when the next split begins are always left out).
ML_SPLIT_GAP_HOURS=24

# --- News classifier (stage 7): uv run python -m wikipulse.ml.train ---
# MLflow tracking server (docker compose --profile mlflow up -d; UI on
# http://localhost:5000). Its metadata lives in this database of the Postgres service and
# its artifacts in this bucket of the S3 store; both are created on first start.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_PORT=5000
MLFLOW_DB=mlflow
MLFLOW_BUCKET=wikipulse-mlflow
# Experiment the training runs go to, and the registered model's name.
ML_EXPERIMENT=news-classifier
ML_MODEL_NAME=news-classifier
# Each model's threshold: the most recall among the thresholds reaching this precision
# on the validation split (ties: the highest threshold); max F1 if none reaches it.
ML_TARGET_PRECISION=0.8
# How the registered model is chosen. Fix it before training; never change it after
# seeing test results. simplest_not_worse: the simplest one (rule, logistic regression,
# trees, neural net) the test set can't tell from the best, i.e. the 95% paired-bootstrap
# interval of its gap in test average precision to the best reaches down to
# ML_SELECT_MARGIN (0: "not significantly worse"). best_test_ap: the highest test AP.
ML_SELECT_RULE=simplest_not_worse
ML_SELECT_MARGIN=0
# Seed for everything random in training (same data + seed = same models).
ML_SEED=42

# --- Serving, drift and retraining (stage 7, spec 07c) ---
# uv run python -m wikipulse.ml.serve scores this detector run's spikes with
# models:/<ML_MODEL_NAME>@champion, FEATURE_WINDOW_MIN minutes after each spike starts.
ML_SERVE_RUN_ID=live
# Wall-clock seconds between looks for spikes to score, and between checks whether the
# champion alias moved (the scorer then loads the new champion).
ML_SERVE_POLL_S=30
ML_SERVE_RELOAD_S=300
# A spike is scored once the stream's event time is this many seconds past its cutoff.
ML_SERVE_LATENESS_S=120
# Hours of edits the live scorer keeps in memory (24 h history + burst + window).
ML_SERVE_BUFFER_HOURS=26
# Retraining (dags/retrain.py) promotes the challenger only if its test average
# precision beats the champion's on the same test rows by at least ML_PROMOTE_MARGIN,
# and only with at least ML_PROMOTE_MIN_TEST_ROWS labeled test rows.
ML_PROMOTE_MARGIN=0.01
ML_PROMOTE_MIN_TEST_ROWS=50
# The models retraining trains and chooses from (by ML_SELECT_RULE).
ML_RETRAIN_MODELS=rule,logreg,gbt,torch
# Drift (python -m wikipulse.ml.drift): a feature or the score has drifted when its
# population stability index against the training data reaches ML_DRIFT_PSI and the
# noise floor (the PSI chance alone stays below with probability ML_DRIFT_CONFIDENCE at
# that week's sample size); a week has drifted when the score has, or at least
# ML_DRIFT_MAX_FEATURES features have. Below ML_DRIFT_MIN_ROWS scored spikes there is
# too little data to judge.
ML_DRIFT_PSI=0.2
ML_DRIFT_CONFIDENCE=0.99
ML_DRIFT_MAX_FEATURES=5
ML_DRIFT_MIN_ROWS=30

# --- Releases (stage 9, spec 09c): uv run python scripts/deploy.py <version> ---
# The registry scripts/deploy.py pulls a release's image and chart from. Empty: the
# GitHub Container Registry of the git remote `origin`'s owner (ghcr.io/<owner>).
WIKIPULSE_REGISTRY=

# --- Docker Compose services ---
POSTGRES_USER=wikipulse
POSTGRES_PASSWORD=wikipulse
POSTGRES_DB=wikipulse
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Connection strings used by the Python code (keep in sync with the values above) ---
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://wikipulse:wikipulse@localhost:5432/wikipulse
