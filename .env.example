# Copy this file to .env and fill in your own values. Never commit .env.

# --- Wikimedia User-Agent (required) ---
# Wikimedia's policy requires a descriptive User-Agent with a way to contact you:
# https://meta.wikimedia.org/wiki/User-Agent_policy
# Replace the GitHub owner and the email with your own. While it still contains the
# placeholder you@example.com, `uv run python -m wikipulse.check` prints a warning.
USER_AGENT="WikiPulse/0.1 (https://github.com/IoakeimKyrgiafinis/wikipulse; you@example.com)"

# --- Logging ---
LOG_LEVEL=INFO

# --- Local data directory (recordings, caches; never committed) ---
DATA_DIR=data

# --- Live stream consumer (stage 1) ---
# Wikimedia EventStreams URL (Server-Sent Events).
STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
# Redis Stream that receives filtered, normalized English Wikipedia article edits.
STREAM_KEY=wiki:edits
# Redis Stream that replay writes to by default (separate, so replays never touch STREAM_KEY).
REPLAY_STREAM_KEY=wiki:replay:edits
# Approximate maximum length of that Redis Stream (older entries are trimmed).
STREAM_MAXLEN=1000000
# Longest wait between reconnect attempts, in seconds (exponential backoff with jitter).
RECONNECT_MAX_S=60

# --- Spike detection (stage 2) ---
# Sliding windows, in minutes: the short one is the "now" signal; edits enter a page's
# baseline only after they leave the long one.
DETECT_SHORT_WINDOW_MIN=10
DETECT_LONG_WINDOW_MIN=60
# Start rule, short window: at least this many human edits from this many people...
DETECT_MIN_EDITS=5
DETECT_MIN_EDITORS=3
# ...or, long window: at least this many edits from this many people.
DETECT_LONG_MIN_EDITS=10
DETECT_LONG_MIN_EDITORS=4
# Either way, also at least this many times the page's expected (baseline) count.
DETECT_MIN_RATIO=5.0
# Lowest expected edits per short window used in the score (z-score stays finite).
DETECT_EXPECTED_FLOOR=0.5
# A spike stays "hot" while its short window holds this many edits, and ends after
# this many minutes without being hot.
DETECT_CONTINUE_MIN_EDITS=2
DETECT_QUIET_PERIOD_MIN=30
# Baseline time constant (hours) and when to forget a page (edits per day).
DETECT_BASELINE_TAU_HOURS=24
DETECT_BASELINE_PRUNE_PER_DAY=0.05
# Daily rhythm: overall edit rate over this many hours vs. over the baseline period,
# clamped to [min, max].
DETECT_RHYTHM_TAU_HOURS=1
DETECT_RHYTHM_MIN=0.5
DETECT_RHYTHM_MAX=2.0
# Count reverts ("Reverted ...", "Undid ...") toward detection? (true/false)
DETECT_COUNT_REVERTS=false
# Seconds between state snapshots to Redis (and spike writes to Postgres). Keep it
# well under a minute so new spikes are enriched within a minute (stage 3).
DETECT_SNAPSHOT_INTERVAL_S=30

# --- Detection evaluation (stage 2) ---
# English Wikipedia's MediaWiki Action API and REST API (portal pages, page summaries).
WIKI_API_URL=https://en.wikipedia.org/w/api.php
WIKI_REST_URL=https://en.wikipedia.org/api/rest_v1
# Smallest pause between two requests to Wikimedia APIs, in seconds. Responses are cached.
WIKI_API_MIN_INTERVAL_S=1.0
# Model that labels spikes for label-based precision, as backend:model.
EVAL_LABEL_MODEL=ollama:qwen3:8b

# --- Page enrichment (stage 3) ---
# Most Wikimedia API requests in flight at once.
WIKI_API_CONCURRENCY=4
# Smallest pause between the starts of two enrichment requests, in seconds.
ENRICH_MIN_INTERVAL_S=0.5
# Hours a cached API response (and an enriched page) stays fresh.
ENRICH_CACHE_TTL_H=24
# Most outgoing article links kept per page.
ENRICH_MAX_LINKS=5000
# Seconds between two looks for new spikes.
ENRICH_POLL_INTERVAL_S=10

# --- Event grouping (stage 3) ---
# Weights of the three signals in the pairwise score: one page links to the other, the
# spikes started close in time, the summaries mean similar things (embeddings).
EVENTS_LINK_WEIGHT=0.4
EVENTS_TIME_WEIGHT=0.2
EVENTS_EMBED_WEIGHT=0.4
# Time signal falls from 1 (same moment) to 0 at this many hours between spike starts.
EVENTS_TIME_WINDOW_H=6
# Embedding signal: cosine similarity at or below this counts 0 (unrelated summaries).
EVENTS_EMBED_FLOOR=0.5
# A spike joins an active event when its score with one of its pages reaches this.
EVENTS_JOIN_THRESHOLD=0.55
# Links from pages with more links than this count proportionally less (0: off).
EVENTS_LINK_HUB_SIZE=1000
# A link counts only if the summaries reach this cosine similarity, so a link from a list
# page to an unrelated article ("Deaths in 2026") can't join pages on its own (0: off).
EVENTS_LINK_MIN_COSINE=0.5
# A spike counts as over this many minutes after its last edit (detector quiet period).
EVENTS_SPIKE_CLOSE_MIN=30
# Embedding model for page summaries (sentence-transformers, runs locally on the CPU).
EVENTS_EMBED_MODEL=BAAI/bge-small-en-v1.5
# Seconds between two looks for new spikes.
EVENTS_POLL_INTERVAL_S=10
# Seconds a live spike waits for its page to be enriched before it is grouped anyway.
EVENTS_ENRICH_WAIT_S=120

# --- LLM client (stage 4) ---
# Model used when no other is named, as backend:model. Backends: ollama (local, free),
# anthropic (optional, needs `uv sync --extra anthropic` and ANTHROPIC_API_KEY).
DEFAULT_MODEL=ollama:qwen3:4b
# Local Ollama server.
OLLAMA_HOST=http://localhost:11434
# Context window in tokens, sent with every call (Ollama silently truncates beyond it).
OLLAMA_NUM_CTX=8192
# How long Ollama keeps a model loaded after a call ("10m", "1h", "0" to unload at once).
OLLAMA_KEEP_ALIVE=10m
# Longest wait for one LLM answer, in seconds.
LLM_TIMEOUT_S=120
# Only for the optional anthropic backend. Leave unset otherwise.
# ANTHROPIC_API_KEY=

# --- Knowledge graph (stage 4) ---
# Neo4j connection (Neo4j Browser: http://localhost:7474, user neo4j, NEO4J_PASSWORD).
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# At least 8 characters. Used by Docker Compose for the container and by the Python code.
# Changing it after the first start needs the neo4j-data volume to be recreated.
NEO4J_PASSWORD=wikipulse-graph
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Model that extracts entities and relationships from events, as backend:model.
EXTRACT_MODEL=ollama:qwen3:4b
# Wikidata API, for linking entity names to Wikidata IDs.
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php
# Pages per event shown to the extraction model (highest spike score first), and the
# characters kept of each page's summary and of its recent changes.
EXTRACT_MAX_PAGES=6
EXTRACT_MAX_CHARS=1200
# Seconds between two looks for new or changed events.
GRAPH_POLL_INTERVAL_S=30
# Wikidata Query Service (SPARQL), the ground truth of the extraction evaluation.
WIKIDATA_SPARQL_URL=https://query.wikidata.org/sparql

# --- Question answering over the graph (stage 5) ---
# Model that writes Cypher queries and answers questions, as backend:model.
QA_MODEL=ollama:qwen3:8b
# A generated Cypher query returns at most this many rows and runs at most this long.
QA_CYPHER_MAX_ROWS=25
QA_CYPHER_TIMEOUT_S=5
# Vector search over page summaries and events: results per question, and the lowest
# cosine similarity between question and text that still counts as relevant.
QA_VECTOR_TOP_K=5
QA_VECTOR_MIN_COSINE=0.63
# Most facts handed to the answering model.
QA_MAX_FACTS=60

# --- Question-answering evaluation (stage 5) ---
# The frozen graph snapshot that evaluations ask: a second Neo4j server (docker compose
# service neo4j-eval, profile "eval"), filled by `scripts/snapshot_graph.py restore`.
NEO4J_EVAL_HTTP_PORT=7475
NEO4J_EVAL_BOLT_PORT=7688
EVAL_QA_NEO4J_URI=bolt://localhost:7688
# Judge models (comma-separated backend:model). The first scores the answers; the others
# judge the same answers so the report can show how far judges agree.
EVAL_QA_JUDGES=ollama:qwen3:8b,ollama:qwen3:4b

# --- Docker Compose services ---
POSTGRES_USER=wikipulse
POSTGRES_PASSWORD=wikipulse
POSTGRES_DB=wikipulse
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Connection strings used by the Python code (keep in sync with the values above) ---
REDIS_URL=redis://localhost:6379/0
POSTGRES_DSN=postgresql://wikipulse:wikipulse@localhost:5432/wikipulse
